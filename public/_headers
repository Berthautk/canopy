# En-têtes Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: https://berthautk.github.io; connect-src 'self' data: blob: https://berthautk.github.io; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Code de l'app : nom de fichier versionné, peut rester en cache un an
/app/*
  Cache-Control: public, max-age=31536000, immutable

# Le service worker et la page doivent toujours être vérifiés, pour que les mises à jour arrivent
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Bible et illustrations : changent rarement
/bible/*
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=2592000

# Réponses du serveur (statistiques, demandes de prière) : jamais gardées en cache
/api/*
  Cache-Control: no-store
